<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="parkit_grid.net.xml"/>
        <route-files value="parkit_grid.rou.xml"/>
        <additional-files value="parkit_grid.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>
    <random_number>
        <seed value="20260918"/>
    </random_number>
    <report>
        <no-step-log value="true"/>
        <no-warnings value="true"/>
    </report>
</configuration>
